BEP_VIET_APP_NAME=Bếp Việt API
BEP_VIET_APP_ENV=development
BEP_VIET_API_V1_PREFIX=/api/v1
BEP_VIET_DATABASE_URL=postgresql+psycopg://bep_viet:bep_viet_local@localhost:5432/bep_viet
BEP_VIET_CORS_ORIGINS=["http://localhost:5173"]
BEP_VIET_FRONTEND_URL=http://localhost:5173
BEP_VIET_LOG_LEVEL=INFO
BEP_VIET_JWT_SECRET=replace-with-at-least-32-random-characters
BEP_VIET_ACCESS_TOKEN_EXPIRE_MINUTES=15
BEP_VIET_REFRESH_TOKEN_EXPIRE_DAYS=30
BEP_VIET_PASSWORD_RESET_EXPIRE_MINUTES=30
BEP_VIET_EMAIL_OTP_EXPIRE_MINUTES=5
BEP_VIET_SESSION_EXPIRE_HOURS=12
BEP_VIET_OAUTH_STATE_EXPIRE_MINUTES=10
BEP_VIET_EMAIL_SMTP_HOST=smtp.gmail.com
BEP_VIET_EMAIL_SMTP_PORT=587
BEP_VIET_EMAIL_SMTP_USERNAME=hvlongg@gmail.com
BEP_VIET_EMAIL_SMTP_PASSWORD=
BEP_VIET_EMAIL_FROM_ADDRESS=hvlongg@gmail.com
BEP_VIET_EMAIL_FROM_NAME=Bếp Việt
BEP_VIET_SUPPORT_EMAIL=hvlongg@gmail.com
BEP_VIET_EMAIL_USE_SSL=false
BEP_VIET_EMAIL_STARTTLS=true
# smtp (local) | gmail_api (cloud host that blocks SMTP ports, e.g. Render free)
BEP_VIET_EMAIL_PROVIDER=smtp
BEP_VIET_EMAIL_GMAIL_CLIENT_ID=
BEP_VIET_EMAIL_GMAIL_CLIENT_SECRET=
BEP_VIET_EMAIL_GMAIL_REFRESH_TOKEN=
BEP_VIET_GOOGLE_CLIENT_ID=
BEP_VIET_GOOGLE_CLIENT_SECRET=
BEP_VIET_GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback
BEP_VIET_FACEBOOK_CLIENT_ID=
BEP_VIET_FACEBOOK_CLIENT_SECRET=
