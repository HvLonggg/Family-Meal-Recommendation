BEP_VIET_APP_NAME=Bếp Việt API
BEP_VIET_APP_ENV=development
BEP_VIET_API_V1_PREFIX=/api/v1
BEP_VIET_DATABASE_URL=postgresql+psycopg://bep_viet:bep_viet_local@localhost:5432/bep_viet
BEP_VIET_CORS_ORIGINS=["http://localhost:5173"]
BEP_VIET_FRONTEND_URL=http://localhost:5173
BEP_VIET_LOG_LEVEL=INFO
BEP_VIET_JWT_SECRET=replace-with-at-least-32-random-characters
BEP_VIET_ACCESS_TOKEN_EXPIRE_MINUTES=15
BEP_VIET_REFRESH_TOKEN_EXPIRE_DAYS=30
BEP_VIET_PASSWORD_RESET_EXPIRE_MINUTES=30
BEP_VIET_EMAIL_OTP_EXPIRE_MINUTES=5
BEP_VIET_SESSION_EXPIRE_HOURS=12
BEP_VIET_OAUTH_STATE_EXPIRE_MINUTES=10
BEP_VIET_EMAIL_SMTP_HOST=smtp.gmail.com
BEP_VIET_EMAIL_SMTP_PORT=587
BEP_VIET_EMAIL_SMTP_USERNAME=<your-account>@gmail.com
BEP_VIET_EMAIL_SMTP_PASSWORD=
BEP_VIET_EMAIL_FROM_ADDRESS=<your-account>@gmail.com
BEP_VIET_EMAIL_FROM_NAME=Bếp Việt
BEP_VIET_SUPPORT_EMAIL=<your-account>@gmail.com
BEP_VIET_EMAIL_USE_SSL=false
BEP_VIET_EMAIL_STARTTLS=true
# auto (choose a configured provider) | smtp (local) | gmail_api (cloud hosts that block SMTP ports)
BEP_VIET_EMAIL_PROVIDER=auto
BEP_VIET_EMAIL_GMAIL_CLIENT_ID=
BEP_VIET_EMAIL_GMAIL_CLIENT_SECRET=
BEP_VIET_EMAIL_GMAIL_REFRESH_TOKEN=
BEP_VIET_GOOGLE_CLIENT_ID=
BEP_VIET_GOOGLE_CLIENT_SECRET=
BEP_VIET_GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback
BEP_VIET_FACEBOOK_CLIENT_ID=
BEP_VIET_FACEBOOK_CLIENT_SECRET=

# Khóa cho tác vụ định kỳ (email nhắc kế hoạch tuần gửi từ GitHub Actions, header X-Cron-Secret).
# Để trống = tắt endpoint /internal/*. Trên máy thật dùng chuỗi ngẫu nhiên dài, không commit.
BEP_VIET_CRON_SECRET=

# Bảo trì có kế hoạch: true → API trả 503, giao diện hiện màn hình bảo trì (giờ ISO, có múi giờ)
BEP_VIET_MAINTENANCE_MODE=false
BEP_VIET_MAINTENANCE_MESSAGE=
BEP_VIET_MAINTENANCE_ENDS_AT=

# Chống quá tải (một tiến trình uvicorn trên Render Free 512 MB / 0,1 CPU).
# Số request API xử lý cùng lúc (0 = tắt); vượt ngưỡng chờ tối đa OVERLOAD_WAIT_SECONDS
# rồi trả 503 OVERLOADED + Retry-After, giao diện hiện "đang đông khách".
BEP_VIET_MAX_CONCURRENT_REQUESTS=64
BEP_VIET_OVERLOAD_WAIT_SECONDS=2
BEP_VIET_OVERLOAD_RETRY_AFTER_SECONDS=15
# Pool kết nối DB (tổng tối đa = POOL_SIZE + MAX_OVERFLOW); hết chỗ quá POOL_TIMEOUT → 503 OVERLOADED.
BEP_VIET_DB_POOL_SIZE=5
BEP_VIET_DB_MAX_OVERFLOW=5
BEP_VIET_DB_POOL_TIMEOUT_SECONDS=10
BEP_VIET_DB_POOL_RECYCLE_SECONDS=300
BEP_VIET_DB_CONNECT_TIMEOUT_SECONDS=15
