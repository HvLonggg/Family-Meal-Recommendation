POSTGRES_DB=bep_viet
POSTGRES_USER=bep_viet
POSTGRES_PASSWORD=change-me-for-non-local-environments
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
BEP_VIET_FRONTEND_URL=http://localhost:5173

# Xác thực và phân quyền
BEP_VIET_JWT_SECRET=replace-with-at-least-32-random-characters
BEP_VIET_ACCESS_TOKEN_EXPIRE_MINUTES=15
BEP_VIET_REFRESH_TOKEN_EXPIRE_DAYS=30
BEP_VIET_PASSWORD_RESET_EXPIRE_MINUTES=30
BEP_VIET_EMAIL_OTP_EXPIRE_MINUTES=5
BEP_VIET_SESSION_EXPIRE_HOURS=12
BEP_VIET_OAUTH_STATE_EXPIRE_MINUTES=10

# Email OTP (SMTP credentials stay on the API server; never commit real values)
BEP_VIET_EMAIL_SMTP_HOST=smtp.gmail.com
BEP_VIET_EMAIL_SMTP_PORT=587
BEP_VIET_EMAIL_SMTP_USERNAME=hvlongg@gmail.com
BEP_VIET_EMAIL_SMTP_PASSWORD=
BEP_VIET_EMAIL_FROM_ADDRESS=hvlongg@gmail.com
BEP_VIET_EMAIL_FROM_NAME=Bếp Việt
BEP_VIET_SUPPORT_EMAIL=hvlongg@gmail.com
BEP_VIET_EMAIL_USE_SSL=false
BEP_VIET_EMAIL_STARTTLS=true
# smtp (local) | gmail_api (cloud host that blocks SMTP ports, e.g. Render free)
BEP_VIET_EMAIL_PROVIDER=smtp
BEP_VIET_EMAIL_GMAIL_CLIENT_ID=
BEP_VIET_EMAIL_GMAIL_CLIENT_SECRET=
BEP_VIET_EMAIL_GMAIL_REFRESH_TOKEN=

# Đăng nhập mạng xã hội (để trống khi chưa cấu hình ứng dụng OAuth)
BEP_VIET_GOOGLE_CLIENT_ID=
BEP_VIET_GOOGLE_CLIENT_SECRET=
BEP_VIET_GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback
BEP_VIET_FACEBOOK_CLIENT_ID=
BEP_VIET_FACEBOOK_CLIENT_SECRET=

# Trợ lý Rồng Con: để trống thì dùng bộ máy gợi ý món nội bộ (miễn phí).
# Điền API key Claude để trả lời bằng AI và đọc được ảnh/PDF người dùng gửi (tính phí theo lượng dùng).
BEP_VIET_ANTHROPIC_API_KEY=
BEP_VIET_ASSISTANT_MODEL=claude-opus-5-5
# Gemini miễn phí (Google AI Studio): dùng khi không có key Claude. auto | claude | gemini
BEP_VIET_GEMINI_API_KEY=
# Bản lite trả lời gần như tức thì (~1 giây), hợp với chat thời gian thực.
BEP_VIET_GEMINI_MODEL=gemini-flash-lite-latest
# Model dự phòng khi model chính quá tải (JSON list).
# BEP_VIET_GEMINI_FALLBACK_MODELS=["gemini-flash-latest"]
BEP_VIET_ASSISTANT_PROVIDER=auto
# RAG: embedding Gemini cho tìm kiếm ngữ nghĩa (cùng API key); không có key thì chỉ dùng BM25.
BEP_VIET_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
BEP_VIET_RAG_TOP_K=6
# AI riêng của Bếp Việt: off | shadow (chỉ ghi log, vẫn dùng Gemini) | auto (in-house cho intent
# đã qua cổng chấm điểm) | inhouse_only. Ngưỡng độ tin cậy / precision tối thiểu của cổng.
BEP_VIET_AI_MODE=shadow
BEP_VIET_AI_MIN_CONFIDENCE=0.8
BEP_VIET_AI_MIN_PRECISION=0.95
# Chuông hẹn giờ khi vào bếp kêu cả lúc khóa màn hình (Web Push). Tạo khóa bằng:
#   docker compose exec backend python -c "from app.modules.cooking.webpush import generate_private_key as g; print(g())"
# Để trống thì chuông chỉ kêu khi ứng dụng còn mở. Đây là khóa bí mật: không commit.
BEP_VIET_WEB_PUSH_VAPID_PRIVATE_KEY=
# Liên hệ gửi kèm cho dịch vụ đẩy (mặc định dùng email gửi thư của hệ thống).
BEP_VIET_WEB_PUSH_SUBJECT=
